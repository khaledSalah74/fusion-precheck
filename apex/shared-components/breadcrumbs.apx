breadcrumb breadcrumb (
    name: Breadcrumb

    entry batches (
        name: Batches
        pageNumber: 1
        execution {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry files (
        name: Files & Mapping
        pageNumber: 10
        appearance {
            parentEntry: @batches
        }
        execution {
            sequence: 20
        }
        link {
            target: {
                page: 10
                items: {
                    P10_BATCH_ID: &FV_BATCH_ID.
                }
            }
        }
    )

    entry results (
