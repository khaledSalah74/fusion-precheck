page 40 (
    name: Ask Claude
    alias: ASK-CLAUDE
    title: Ask Claude
    pageGroup: @batch
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @fv-user
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript
            (function ($) {
                var REGION = 'fv-conversation';
                var $input = $('#fv-chat-input');
                var $send = $('#fv-chat-send');
                var busy = false;

                function body() { return $('#' + REGION + ' .t-Region-body'); }
                function scrollDown() { var b = body()[0]; if (b) { b.scrollTop = b.scrollHeight; } }
                function grow() { var el = $input[0]; el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 160) + 'px'; }

                function send(question) {
                    question = (question || '').trim();
                    if (!question || busy) { return; }
                    busy = true;
                    $send.prop('disabled', true);
                    $input.val('');
                    grow();
                    body().find('.t-Report-report, .nodatafound').last().after(
                        '<div class="fv-pending">' +
                        '<div class="fv-row fv-row--user"><div class="fv-bubble" dir="auto">' + apex.util.escapeHTML(question) + '</div></div>' +
                        '<div class="fv-row fv-row--ai"><div class="fv-avatar" aria-hidden="true">C</div>' +
                        '<div class="fv-bubble fv-typing" aria-label="Claude is typing"><span></span><span></span><span></span></div></div>' +
                        '</div>');
                    body().find('.nodatafound').hide();
                    scrollDown();
                    apex.server.process('ASK', { x01: question, pageItems: '#P40_BATCH_ID' }, { dataType: 'json' })
                        .done(function (d) {
                            if (d && d.status === 'E') {
                                apex.message.showErrors([{ type: 'error', location: 'page', message: d.message, unsafe: false }]);
                            }
                        })
                        .fail(function () {
                            apex.message.showErrors([{ type: 'error', location: 'page', message: 'Claude could not be reached. Try again.', unsafe: false }]);
                        })
                        .always(function () {
                            busy = false;
                            $send.prop('disabled', false);
                            apex.region(REGION).refresh();
                            $input.trigger('focus');
                        });
                }

                $input.on('input', grow).on('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send($input.val()); }
                });
                $send.on('click', function () { send($input.val()); });
                $(document).on('click', '.fv-chip', function () { send($(this).data('q')); });
                $('#' + REGION).on('apexafterrefresh', scrollDown);
                scrollDown();
                $input.trigger('focus');
            })(apex.jQuery);
            ```
    }

    region breadcrumb (
        name: Ask Claude
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region conversation (
        name: Claude - batch analyst
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select report_id,
                       question,
                       answer,
                       answer_css,
                       asked_on
                  from (select r.report_id,
                               json_value(r.context_json, '$.question' returning varchar2(4000)) question,
                               case r.status_code
                                   when 'COMPLETED' then json_value(r.response_json, '$.answer' returning varchar2(32000) truncate)
                                   else 'Sorry, I could not answer that: ' || r.error_message
                               end answer,
                               case r.status_code when 'COMPLETED' then 'fv-bubble' else 'fv-bubble fv-bubble--error' end answer_css,
                               to_char(r.requested_on, 'DD Mon HH24:MI') asked_on
                          from xxx_fv_ai_reports r
                         where r.batch_id = :P40_BATCH_ID
                           and r.report_type = 'CHAT'
                           and r.requested_by = :APP_USER
                         order by r.report_id desc
                         fetch first 100 rows only)
                 order by report_id
                ```
            pageItemsToSubmit: P40_BATCH_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: fv-chat
        }
        advanced {
            htmlDomId: fv-conversation
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: <div class="fv-row fv-row--ai"><div class="fv-avatar" aria-hidden="true">C</div><div class="fv-bubble" dir="auto">Hi, I am Claude. Ask me anything about this batch, for example "Which supplier issues block the load?" or "لماذا لا يتطابق رصيد الموردين مع الأستاذ العام؟"</div></div>
        }

        column REPORT_ID (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column QUESTION (
            type: plainText
            heading {
                heading: Conversation
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <div class="fv-row fv-row--user"><div class="fv-bubble" dir="auto">#QUESTION#</div></div><div class="fv-row fv-row--ai"><div class="fv-avatar" aria-hidden="true">C</div><div class="fv-msg-col"><div class="#ANSWER_CSS#" dir="auto">#ANSWER#</div><div class="fv-time">#ASKED_ON#</div></div></div>
            }
        )

        column ANSWER (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column ANSWER_CSS (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column ASKED_ON (
            type: hidden
            layout {
                sequence: 50
            }
        )
    )

    region composer (
        name: Message
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="fv-chips" role="group" aria-label="Suggested questions">
                  <button type="button" class="fv-chip" data-q="Top 5 blocking issues">Top 5 blocking issues</button>
                  <button type="button" class="fv-chip" data-q="Explain the AP to GL difference">Explain the AP to GL difference</button>
                  <button type="button" class="fv-chip" data-q="What should the client fix first?">What should the client fix first?</button>
                  <button type="button" class="fv-chip" data-q="لخص الوضع بالعربي" dir="rtl">لخص الوضع بالعربي</button>
                </div>
                <div class="fv-composer">
                  <textarea id="fv-chat-input" rows="1" dir="auto" maxlength="2000" placeholder="Message Claude about this batch..." aria-label="Message"></textarea>
                  <button type="button" id="fv-chat-send" class="fv-send" aria-label="Send" title="Send (Enter)"><span class="fa fa-send" aria-hidden="true"></span></button>
                </div>
                <div class="fv-hint">Enter to send, Shift+Enter for a new line. Claude answers only from this batch's validation facts.</div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: fv-composer-region
        }
    )

    pageItem P40_BATCH_ID (
        type: hidden
        layout {
            sequence: 10
            region: @composer
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    computation set-current-batch (
        itemName: FV_BATCH_ID
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            type: item
            itemName: P40_BATCH_ID
        }
    )

    process ask (
        name: ASK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status varchar2(1);
                    l_msg    varchar2(4000);
                begin
                    xxx_fv_batch_api.ask_claude(:P40_BATCH_ID, apex_application.g_x01, :APP_USER, l_status, l_msg);
                    apex_json.open_object;
                    apex_json.write('status', l_status);
                    apex_json.write('message', l_msg);
                    apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )

)
